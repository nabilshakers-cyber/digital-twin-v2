rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Reusable Hardened Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerified() && isValidId(userId) && request.auth.uid == userId;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function isOptionalIntRange(data, key, minVal, maxVal) {
      return !(key in data) || ((data[key] is int || data[key] is float) && data[key] >= minVal && data[key] <= maxVal);
    }

    function isValidProfileMap(p) {
      return p is map
        && p.keys().hasAll(['name', 'role', 'tone', 'peakEnergy', 'workStyle', 'mainGoals', 'rules', 'dailyWorkHoursTarget'])
        && p.keys().hasOnly([
          'name', 'role', 'avatarSeed', 'tone', 'peakEnergy', 'workStyle',
          'mainGoals', 'rules', 'dailyWorkHoursTarget', 'weeklyCompletionGoalRate',
          'dailyEnergyLevel', 'endOfDayOverloadAlertEnabled', 'endOfDayAlertTime',
          'focusSessionMinutes'
        ])
        && p.name is string && p.name.size() <= 120
        && p.role is string && p.role.size() <= 200
        && isOptionalString(p, 'avatarSeed', 128)
        && p.tone is string && p.tone in ['disciplined', 'encouraging', 'analytical', 'calm', 'humorous']
        && p.peakEnergy is string && p.peakEnergy.size() <= 200
        && p.workStyle is string && p.workStyle.size() <= 300
        && p.mainGoals is string && p.mainGoals.size() <= 1500
        && p.rules is string && p.rules.size() <= 2000
        && (p.dailyWorkHoursTarget is int || p.dailyWorkHoursTarget is float)
        && p.dailyWorkHoursTarget >= 1 && p.dailyWorkHoursTarget <= 24
        && isOptionalIntRange(p, 'weeklyCompletionGoalRate', 10, 100)
        && (!('dailyEnergyLevel' in p) || (p.dailyEnergyLevel is string && p.dailyEnergyLevel in ['low', 'medium', 'high']))
        && isOptionalBool(p, 'endOfDayOverloadAlertEnabled')
        && (!('endOfDayAlertTime' in p) || (p.endOfDayAlertTime is string && p.endOfDayAlertTime.size() >= 4 && p.endOfDayAlertTime.size() <= 8 && p.endOfDayAlertTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && isOptionalIntRange(p, 'focusSessionMinutes', 5, 180);
    }

    function isValidAdhkarMap(a) {
      return a is map
        && a.keys().hasAll(['date', 'morningCompleted', 'eveningCompleted', 'totalFullDaysCompleted'])
        && a.keys().hasOnly(['date', 'morningCompleted', 'eveningCompleted', 'totalFullDaysCompleted', 'lastCountedFullDay', 'morningCompletedAt', 'eveningCompletedAt'])
        && a.date is string && a.date.size() <= 32
        && a.morningCompleted is bool
        && a.eveningCompleted is bool
        && (a.totalFullDaysCompleted is int || a.totalFullDaysCompleted is float) && a.totalFullDaysCompleted >= 0 && a.totalFullDaysCompleted <= 100000
        && isOptionalString(a, 'lastCountedFullDay', 32)
        && isOptionalString(a, 'morningCompletedAt', 64)
        && isOptionalString(a, 'eveningCompletedAt', 64);
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'profile', 'dashboardLayout', 'adhkarState',
          'quranNotificationsEnabled', 'pushEnabled', 'soundEnabled', 'autoDndEnabled',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'profile', 'dashboardLayout', 'adhkarState',
          'quranNotificationsEnabled', 'pushEnabled', 'soundEnabled', 'autoDndEnabled',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && isValidProfileMap(data.profile)
        && data.dashboardLayout is list && data.dashboardLayout.size() <= 60
        && (data.dashboardLayout.size() == 0 || (data.dashboardLayout[0] is map && data.dashboardLayout[0].keys().hasAll(['id', 'visible'])))
        && isValidAdhkarMap(data.adhkarState)
        && data.quranNotificationsEnabled is bool
        && data.pushEnabled is bool
        && data.soundEnabled is bool
        && data.autoDndEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, userId, taskId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'category', 'priority', 'status',
          'energyRequired', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'category', 'priority', 'status',
          'estimatedMinutes', 'dueDate', 'dueTime', 'energyRequired', 'subtasks',
          'isTopPriority', 'isUnclassified', 'clientCreatedAt', 'completedAt', 'goalId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == taskId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isOptionalString(data, 'description', 2000)
        && data.category is string && data.category in ['work', 'personal', 'health', 'study', 'urgent']
        && data.priority is string && data.priority in ['high', 'medium', 'low']
        && data.status is string && data.status in ['todo', 'in_progress', 'completed']
        && isOptionalIntRange(data, 'estimatedMinutes', 1, 1440)
        && isOptionalString(data, 'dueDate', 32)
        && isOptionalString(data, 'dueTime', 16)
        && data.energyRequired is string && data.energyRequired in ['high', 'medium', 'low']
        && (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 50 && (data.subtasks.size() == 0 || data.subtasks[0] is map)))
        && isOptionalBool(data, 'isTopPriority')
        && isOptionalBool(data, 'isUnclassified')
        && data.clientCreatedAt is string && data.clientCreatedAt.size() <= 64
        && isOptionalString(data, 'completedAt', 64)
        && isOptionalString(data, 'goalId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduleBlock(data, userId, blockId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'startTime', 'endTime', 'title', 'category', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'startTime', 'endTime', 'title', 'description', 'category',
          'priority', 'energyLevel', 'relatedTaskId', 'isCompleted', 'isFixed',
          'iconName', 'date', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == blockId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.startTime is string && data.startTime.size() >= 3 && data.startTime.size() <= 16
        && data.endTime is string && data.endTime.size() >= 3 && data.endTime.size() <= 16
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isOptionalString(data, 'description', 1500)
        && data.category is string && data.category in ['deep_work', 'meeting', 'routine', 'health', 'personal', 'review']
        && (!('priority' in data) || (data.priority is string && data.priority in ['high', 'medium', 'low']))
        && (!('energyLevel' in data) || (data.energyLevel is string && data.energyLevel in ['high', 'medium', 'low']))
        && isOptionalString(data, 'relatedTaskId', 128)
        && isOptionalBool(data, 'isCompleted')
        && isOptionalBool(data, 'isFixed')
        && isOptionalString(data, 'iconName', 64)
        && isOptionalString(data, 'date', 32)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId, goalId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'category', 'progress', 'targetDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'category', 'progress', 'targetDate',
          'associatedProject', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == goalId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.category is string && data.category in ['work', 'personal', 'learning', 'health']
        && (data.progress is int || data.progress is float) && data.progress >= 0 && data.progress <= 100
        && data.targetDate is string && data.targetDate.size() <= 32
        && isOptionalString(data, 'associatedProject', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuranRoutine(data, userId, itemId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'type', 'title', 'targetAmount', 'completed', 'timeSlot', 'streak', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'type', 'title', 'targetAmount', 'completed', 'timeSlot', 'streak', 'quickLink', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == itemId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.type is string && data.type in ['review', 'reading', 'memorization']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.targetAmount is string && data.targetAmount.size() >= 1 && data.targetAmount.size() <= 240
        && data.completed is bool
        && data.timeSlot is string && data.timeSlot.size() <= 120
        && (data.streak is int || data.streak is float) && data.streak >= 0 && data.streak <= 100000
        && isOptionalString(data, 'quickLink', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomWidget(data, userId, widgetId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'kind', 'title', 'icon', 'color', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'kind', 'title', 'icon', 'color', 'content', 'items',
          'count', 'target', 'unit', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == widgetId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.kind is string && data.kind in ['note', 'checklist', 'counter', 'links']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.icon is string && data.icon.size() <= 32
        && data.color is string && data.color in ['cyan', 'emerald', 'amber', 'indigo', 'rose']
        && isOptionalString(data, 'content', 2000)
        && (!('items' in data) || (data.items is list && data.items.size() <= 50 && (data.items.size() == 0 || data.items[0] is map)))
        && isOptionalIntRange(data, 'count', 0, 100000)
        && isOptionalIntRange(data, 'target', 1, 100000)
        && isOptionalString(data, 'unit', 40)
        && data.clientCreatedAt is string && data.clientCreatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoneAppList(data, userId, listId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'icon', 'color', 'apps', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'icon', 'color', 'apps', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == listId
        && isValidId(data.ownerId) && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.icon is string && data.icon.size() <= 32
        && data.color is string && data.color in ['cyan', 'emerald', 'amber', 'indigo', 'rose']
        && data.apps is list && data.apps.size() <= 50
        && (data.apps.size() == 0 || data.apps[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Workspace & Settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['profile', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dashboardLayout', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['adhkarState', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['quranNotificationsEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['pushEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['soundEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['autoDndEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'profile', 'dashboardLayout', 'adhkarState',
            'quranNotificationsEnabled', 'pushEnabled', 'soundEnabled', 'autoDndEnabled',
            'updatedAt'
          ])
        );
      allow delete: if isOwner(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(taskId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidTask(incoming(), userId, taskId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(taskId)
          && isValidTask(incoming(), userId, taskId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().clientCreatedAt == existing().clientCreatedAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'status', 'completedAt', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['dueDate', 'isTopPriority', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'category', 'priority', 'status',
              'estimatedMinutes', 'dueDate', 'dueTime', 'energyRequired',
              'subtasks', 'isTopPriority', 'isUnclassified', 'completedAt', 'goalId', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Schedule / Calendar TimeBlocks subcollection
      match /schedule/{blockId} {
        allow get: if isOwner(userId) && isValidId(blockId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(blockId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidScheduleBlock(incoming(), userId, blockId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(blockId)
          && isValidScheduleBlock(incoming(), userId, blockId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'startTime', 'endTime', 'title', 'description', 'category',
              'priority', 'energyLevel', 'relatedTaskId', 'isCompleted',
              'isFixed', 'iconName', 'date', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(blockId);
      }

      // Long-Term Goals subcollection
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(goalId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidGoal(incoming(), userId, goalId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(goalId)
          && isValidGoal(incoming(), userId, goalId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'progress', 'targetDate', 'associatedProject', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Quran Routine subcollection
      match /quranRoutine/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(itemId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidQuranRoutine(incoming(), userId, itemId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(itemId)
          && isValidQuranRoutine(incoming(), userId, itemId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'streak', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'type', 'title', 'targetAmount', 'completed', 'timeSlot', 'streak', 'quickLink', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Custom Dashboard Widgets subcollection
      match /customWidgets/{widgetId} {
        allow get: if isOwner(userId) && isValidId(widgetId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(widgetId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidCustomWidget(incoming(), userId, widgetId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(widgetId)
          && isValidCustomWidget(incoming(), userId, widgetId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().clientCreatedAt == existing().clientCreatedAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['count', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['items', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'kind', 'title', 'icon', 'color', 'content', 'items', 'count', 'target', 'unit', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(widgetId);
      }

      // Phone App Lists subcollection
      match /phoneAppLists/{listId} {
        allow get: if isOwner(userId) && isValidId(listId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(listId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPhoneAppList(incoming(), userId, listId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(listId)
          && isValidPhoneAppList(incoming(), userId, listId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['apps', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'icon', 'color', 'apps', 'updatedAt'
            ])
          );
        allow delete: if isOwner(userId) && isValidId(listId);
      }
    }
  }
}
